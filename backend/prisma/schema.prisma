generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  password String
  bookings Booking[]
  comments Comment[]
}

model Admin {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  movies   Movie[]
}

model HomeHeroSettings {
  id          String   @id @default(cuid())
  key         String   @unique @default("main")
  badgeLabel  String
  title       String
  description String
  posterUrl   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Movie {
  id          String    @id @default(cuid())
  title       String
  description String
  actors      String[]
  releaseDate DateTime
  posterUrl   String
  ticketPrice Float
  featured    Boolean   @default(false)
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  comments    Comment[]
  showtimes   Showtime[]
}

model Showtime {
  id         String    @id @default(cuid())
  movieId    String
  movie      Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  startTime  DateTime
  hall       String
  price      Float
  totalSeats Int
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([movieId, startTime])
  @@unique([movieId, startTime, hall])
}

model Booking {
  id                String   @id @default(cuid())
  movieId           String
  movie             Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  showtimeId        String?
  showtime          Showtime? @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  date              DateTime
  seatNumber        String
  customerFirstName String
  customerLastName  String
  phoneNumber       String
  paymentMethod     String
  paymentStatus     String   @default("paid")
  totalPrice        Float
  ticketCode        String
  qrCodeValue       String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([showtimeId, seatNumber])
}

model Comment {
  id         String   @id @default(cuid())
  movieId    String
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieTitle String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName   String
  userEmail  String
  text       String
  rating     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([movieId])
  @@index([userId])
}
